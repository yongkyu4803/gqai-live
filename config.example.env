# GQAI Live settings. scripts/setup-mac.sh copies this to config.env (not committed).
# Real environment variables override these values. Relative paths are relative to the project folder.

# Local web server port (the Mac app reads it at build time: rebuild with mac/build.sh after changing it)
GQAI_PORT=7860

# whisper.cpp (built by scripts/setup-mac.sh)
GQAI_WHISPER_BIN_DIR=vendor/whisper.cpp/build/bin
GQAI_WHISPER_MODEL=models/ggml-large-v3.bin
GQAI_WHISPER_PORT=8178

# Claude cleanup. Leave ANTHROPIC_API_KEY empty to use your local `claude` login (scripts/claude-login.sh).
GQAI_CLAUDE_MODEL=claude-sonnet-5-5
GQAI_CLAUDE_EFFORT=low
# ANTHROPIC_API_KEY=

# Where data (term dictionary) and logs go
# GQAI_DATA_DIR=data
# GQAI_LOG_DIR=~/Library/Logs/GQAILive
